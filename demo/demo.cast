[0.6, "o", "\u001b[32m\u256d\u2500\u001b[0m\u001b[32m agent \u001b[0m\u001b[32m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[32m\u2500\u256e\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1mJohn Haddad (#5, score 79, maybe) outranks Jane Volkov (unranked, score 38, no-hire) because he matches \u001b[0m   \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1mthe backend stack and she doesn't.\u001b[0m                                                                         \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1mNote:\u001b[0m \"Jane\" matches three candidates: Jane Smith, Jane Volkov and Jane Wei. The tool used Jane Volkov,    \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m the best-scoring of the three for this role. She is not in the top 10, so she was scored on the f"]
[0.0, "o", "ly. Tell  \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m me if you meant a different Jane.                                                                          \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m                                              \u001b[0m                                                             \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0m\u001b[36mComponent\u001b[0m\u001b[1m  \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mJohn Haddad\u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mJane Volkov\u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mDelta\u001b[0m\u001b[36m \u001b[0m                                                             \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0m                                                             \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0mSemantic    \u001b[36m \u001b[0m82          \u001b[36m \u001b[0m43          \u001b[36m \u001b[0m+39  \u001b[36m \u001b[0m       "]
[0.0, "o", "                                                      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0mKeyword     \u001b[36m \u001b[0m71          \u001b[36m \u001b[0m29          \u001b[36m \u001b[0m+42  \u001b[36m \u001b[0m                                                             \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0mRound 1     \u001b[36m \u001b[0m78          \u001b[36m \u001b[0m37          \u001b[36m \u001b[0m+41  \u001b[36m \u001b[0m                                                             \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0mRound 2 fit \u001b[36m \u001b[0m80          \u001b[36m \u001b[0m38          \u001b[36m \u001b[0m+42  \u001b[36m \u001b[0m                                                             \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0m\u001b[1mFinal\u001b[0m       \u001b[36m \u001b[0m\u001b[1m79\u001b[0m          \u001b[36m \u001b[0m\u001b[1m38\u001b[0m          \u001b[36m \u001b[0m\u001b[1m+41\u001b[0m  \u001b[36m \u001b[0m                                                             \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m                                              \u001b[0m                                                             \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                     "]
[0.0, "o", "                                                       \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m The formula is \u001b[1;36;40mfinal = 0.4 \u00d7 round1 + 0.6 \u00d7 fit\u001b[0m.                                                           \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1mWhy John wins\u001b[0m                                                                                              \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m \u2022 \u001b[0mHe has PostgreSQL and REST APIs, which are must-haves. Jane has neither.                                \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m \u2022 \u001b[0mHe has Redis and Docker, which are nice-to-haves. Jane has neither.                                     \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m \u2022 \u001b[0mHis current role uses Python, Django and PostgreSQL.                             "]
[0.0, "o", "                       \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m \u2022 \u001b[0mHe has 6 years of experience and a 60% reduction in incident count.                                     \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1mJane's gaps\u001b[0m                                                                                                \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m \u2022 \u001b[0mHer experience is mostly ML: PyTorch, NLP, scikit-learn, MLOps and Spark. It isn't backend service      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m   \u001b[0mengineering.                                                                                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m \u2022 \u001b[0mShe lists no PostgreSQL, REST, Redis, Docker or microservices.                                          \u001b[32m\u2502\u001b[0m\r\n\u001b[3"]
[0.0, "o", "2m\u2502\u001b[0m \u001b[1m \u2022 \u001b[0mShe has 7 years of experience, one more than John.                                                      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m \u2022 \u001b[0mShe does list SQL, which John doesn't list explicitly. It appears only in her skills list, with no      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m   \u001b[0mhands-on use described.                                                                                 \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1mJohn's weaknesses\u001b[0m                                                                                          \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m \u2022 \u001b[0mHis bullets are vague.                                                                                  \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m \u2022 \u001b[0mHis claim of ment"]
[0.0, "o", "oring 53 engineers is unclear.                                                         \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m \u2022 \u001b[0mThere is no evidence of REST work in his current role.                                                  \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m \u2022 \u001b[0mThere is no microservices experience.                                                                   \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n"]
