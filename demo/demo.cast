[0.6, "o", "\u001b[32m\u256d\u2500\u001b[0m\u001b[32m agent \u001b[0m\u001b[32m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[32m\u2500\u256e\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1mZoe Conti (#1) and Carlos Lin (#3) have the same final score, 83. Conti ranks higher because of the \"hire\"\u001b[0m \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1mverdict and her better round-2 fit score.\u001b[0m                                                                  \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m                                                     \u001b[0m                                                      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0m\u001b[36mComponent\u001b[0m\u001b[1m  \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mZoe Conti (#1)\u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b"]
[0.0, "o", "[0m\u001b[36mCarlos Lin (#3)\u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mDelta\u001b[0m\u001b[36m \u001b[0m                                                      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0m                                                      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0mRound 1     \u001b[36m \u001b[0m76             \u001b[36m \u001b[0m82              \u001b[36m \u001b[0m\u22126   \u001b[36m \u001b[0m                                                      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0mSemantic    \u001b[36m \u001b[0m79             \u001b[36m \u001b[0m80              \u001b[36m \u001b[0m\u22121   \u001b[36m \u001b[0m                                                      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0mKeyword     \u001b[36m \u001b[0m71             \u001b[36m \u001b[0m86              \u001b[36m \u001b[0m\u221215  \u001b[36m \u001b[0m                                                      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0mRound 2 fit \u001b[36m \u001b[0m88             \u001b[36m \u001b[0m84              \u001b[36m \u001b[0m+4"]
[0.0, "o", "   \u001b[36m \u001b[0m                                                      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0m\u001b[1mFinal\u001b[0m       \u001b[36m \u001b[0m\u001b[1m83\u001b[0m             \u001b[36m \u001b[0m\u001b[1m83\u001b[0m              \u001b[36m \u001b[0m0    \u001b[36m \u001b[0m                                                      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m                                                     \u001b[0m                                                      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m The formula is \u001b[1;36;40mfinal = 0.4 \u00d7 round1 + 0.6 \u00d7 fit\u001b[0m, where round1 = 0.6 \u00d7 semantic + 0.4 \u00d7 keyword.            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m \u2022 \u001b[0m\u001b[1mLin led round 1.\u001b[0m His keyword score was 15 points higher. He lists all three nice-to-haves, including    \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m   \u001b[0mM"]
[0.0, "o", "icroservices.                                                                                          \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m \u2022 \u001b[0m\u001b[1mConti led round 2.\u001b[0m Her fit score was 4 points higher, and that round carries 60% of the weight. That    \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m   \u001b[0mroughly cancels Lin's round-1 lead.                                                                     \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m \u2022 \u001b[0m\u001b[1mConti's evidence is more concrete.\u001b[0m                                                                      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m   \u001b[0m\u001b[1m \u2022 \u001b[0mShe has 7 years and is currently a Senior Backend Engineer.                                          \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m   \u001b[0m\u001b[1m \u2022 \u001b[0mShe cut p95 latency by 58%.                                                                          \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m   \u001b[0m\u001b[1m \u2022 \u001b[0mShe led a migration serving 50M users.                                                               \u001b[32m\u2502\u001b[0m\r\n\u001b[32m"]
[0.0, "o", "\u2502\u001b[0m \u001b[1m \u2022 \u001b[0m\u001b[1mLin's evidence is vaguer.\u001b[0m                                                                               \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m   \u001b[0m\u001b[1m \u2022 \u001b[0mHis bullets have no performance metrics.                                                             \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m   \u001b[0m\u001b[1m \u2022 \u001b[0mDocker and Microservices appear only in his skills list.                                             \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m   \u001b[0m\u001b[1m \u2022 \u001b[0mHis claim of 8 years doesn't fit his listed roles, which add up to about 6\u20137 years.                  \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m   \u001b[0m\u001b[1m \u2022 \u001b[0mHis claim of mentoring 52 engineers is unclear.                                                      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1m   \u001b[0m\u001b[1m \u2022 \u001b[0mThere's an unexplained gap between 2014 and 2018.                                                    \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                       "]
[0.0, "o", "     \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[1mShared gaps:\u001b[0m neither resume lists SQL as a standalone skill, so it is only implied by PostgreSQL. Conti is \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m also missing explicit Microservices. Docker appears only in her skills list.                               \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m The tool output doesn't say how the tie was broken. The ranks and verdicts look driven by the round-3      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m verdict, which is \"hire\" for Conti and \"maybe\" for Lin. Also, #2 Carlos Silva scores 84, one point above   \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m both of them, yet ranks below Conti. That is consistent with verdict taking priority over raw score.       \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\ufffd"]
