[0.0, "o", "\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0m2 \u001b[36m \u001b[0mCarlos Silva \u001b[36m \u001b[0m84    \u001b[36m \u001b[0mmaybe   \u001b[36m \u001b[0mHe has 9 years, a current Python/PostgreSQL stack and REST experience, \u001b[36m \u001b[0m \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0m  \u001b[36m \u001b[0m             \u001b[36m \u001b[0m      \u001b[36m \u001b[0m        \u001b[36m \u001b[0mso he is technically well matched\u2026                                     \u001b[36m \u001b[0m \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0m3 \u001b[36m \u001b[0mCarlos Lin   \u001b[36m \u001b[0m83    \u001b[36m \u001b[0mmaybe   \u001b[36m \u001b[0mHe has strong seniority, full nice-to-have coverage and current        \u001b[36m \u001b[0m \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0m  \u001b[36m \u001b[0m             \u001b[36m \u001b[0m      \u001b[36m \u001b[0m        \u001b[36m \u001b[0mPython/Django/PostgreSQL use, and SQL is\u2026                              \u001b[36m \u001b[0m \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0m4 \u001b[36m \u001b[0mZoe Cohen    \u001b[36m \u001b[0m80    \u001b[36m \u001b[0mmaybe   \u001b[36m \u001b[0mPython, PostgreSQL and REST APIs are tied to real roles over 4 years,  \u001b[36m \u001b[0m \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0m  \u001b[36m \u001b[0m             \u001b[36m \u001b[0m      \u001b[36m \u001b"]
[0.0, "o", "[0m        \u001b[36m \u001b[0mand the SQL gap is only implied by\u2026                                    \u001b[36m \u001b[0m \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0m5 \u001b[36m \u001b[0mJohn Haddad  \u001b[36m \u001b[0m79    \u001b[36m \u001b[0mmaybe   \u001b[36m \u001b[0mHe covers Python, PostgreSQL and REST with 6 years and shows Redis and \u001b[36m \u001b[0m \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m \u001b[0m  \u001b[36m \u001b[0m             \u001b[36m \u001b[0m      \u001b[36m \u001b[0m        \u001b[36m \u001b[0mDocker experience. Recent REST and\u2026                                    \u001b[36m \u001b[0m \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[36m                                                                                                          \u001b[0m \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m Full report: \u001b[1;36;40mreports/backend_engineer_v1_20261028_105920.md\u001b[0m                                                \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\ufffd"]
