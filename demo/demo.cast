[0.6, "o", "\u001b[36m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\r\n\u001b[36m\u2502\u001b[0m Resume Matching Agent \u2014 LangGraph \u00b7 3-round screening over 100 resumes                                     \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u2502\u001b[0m LLM: claude-sonnet-5-5                                                                                     \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u2502\u001b[0m Start with a JD file (e.g. \u001b[1mjobs/jd_ml_engineer.txt\u001b[0m) or a request like \u001b[1mFind me candidates with React and 3+\u001b[0m \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u2502\u001b[0m \u001b[1myears experience\u001b[0m.                                                                                          \u001b[36m\u2502\u001b[0m\r\n\u001b[36m\u2502\u001b[0m Then ask questions, refine requirements, or type \u001b[1mdone\u001b[0m.                                             "]
